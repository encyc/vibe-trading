# LLM 配置文件示例
#
# 复制为 llm.yaml 后按需修改（llm.yaml 已被 .gitignore 忽略，不会提交）。
#
# 每个条目映射到 zenagent 的 Model。`provider` 是 zenagent catalog 里的
# provider id（见 zenagent/catalog.yaml），base_url / api_key_env / adapter /
# compat / context_window 都从 catalog 继承，所以通常只需要写 model。
#
# 凭证来源（本文件不写明文 key）：
#   1. ~/.zenagent/settings.json 的 "api_keys"（优先）
#   2. 环境变量（回退）
# 键名取自 catalog 的 api_key_env，如 OPENAI_API_KEY / ZAI_CODING_CN_API_KEY。
#
# 条目字段：
#   provider       catalog provider id（必需）
#   model          catalog model id（必需）
#   base_url       覆盖 catalog 的 base_url（可选，catalog 未收录时必填）
#   context_window 覆盖 catalog 的上下文窗口（可选）
#   max_tokens     覆盖 catalog 的输出上限（可选）
#   temperature    该 agent 的采样温度（可选；缺省用服务商默认）
#   description    人类可读说明（可选）

# 当前使用的 LLM 配置名称（可用 LLM_MODEL 环境变量覆盖）
use_llm: openai_gpt4o_mini


llms:

  # ========== OpenAI ==========
  openai_gpt4o_mini:
    provider: openai
    model: gpt-4o-mini
    description: "OpenAI GPT-4o mini"

  openai_gpt4o:
    provider: openai
    model: gpt-4o
    description: "OpenAI GPT-4o"

  # ========== DeepSeek（按量计费）==========
  deepseek_flash:
    provider: deepseek
    model: deepseek-flash
    description: "DeepSeek Flash（1M 上下文）"

  # ========== Z.AI Coding（包月 token plan）==========
  glm_5_3_flash:
    provider: zai-coding-cn
    model: glm-5.3-flash
    description: "智谱 GLM-5.3-Flash（zai coding plan）"

  # ========== OpenCode Go（订阅制网关）==========
  opencode_deepseek_v4_pro:
    provider: opencode-go
    model: deepseek-v4-pro
    description: "DeepSeek V4 Pro 经 OpenCode Go"

  # ========== 自建 / 代理端点（不在 catalog 里）==========
  # 必须显式给 base_url；api 按 provider 自动推断
  # （anthropic -> anthropic-messages，google -> google-generative-ai，
  #   其余 -> openai-completions），也可用 api 字段强制指定。
  #
  # local_ollama:
  #   provider: openai
  #   model: llama3
  #   base_url: http://localhost:11434/v1
  #   description: "本地 Ollama"
